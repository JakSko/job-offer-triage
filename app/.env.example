# Wzor konfiguracji. Skopiuj do app/.env i uzupelnij. Plik .env NIGDY nie trafia do repo.
# Opis zmiennych: docs/migracja/03_architektura_i_konfiguracja.md

TRYB=laptop

# Skrzynka z alertami (potrzebne od fazy F5)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
MAX_MAILI=20

# Arkusz Google (potrzebne od fazy F2)
GOOGLE_SA_FILE=
SHEET_ID=

# OpenAI (potrzebne od fazy F3)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Push ntfy: pelny adres tematu (potrzebne od fazy F4). Temat dziala jak haslo.
NTFY_URL=

# Opcjonalne
# Plik master CV (domyslnie dane/cv_master.docx). Na Railway nie ustawiac.
CV_MASTER_FILE=
JINA_API_KEY=
FETCH_MODE=jina
LIMIT_AI=30
LIMIT_CZASU_MIN=20
ZALEGLE_DNI=7
HEARTBEAT_GODZINA=20
